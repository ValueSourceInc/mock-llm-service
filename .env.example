# Server
PORT=8787

# Latency model
TTFT_MS=500          # time to first token (stream) / initial delay (non-stream)
TOKEN_INTERVAL_MS=20 # per-token delay (~50 tok/s at 20ms)
DEFAULT_OUTPUT_TOKENS=512

# Fault injection (0 = off, 0.1 = 10% of requests)
ERROR_RATE=0
ERROR_429_RATE=0
ERROR_500_RATE=0
ERROR_TIMEOUT_RATE=0   # hang for TIMEOUT_MS then never respond
TIMEOUT_MS=30000

# Models advertised at GET /v1/models
MODELS=mock-gpt-5.2,mock-gpt-5.2-mini,mock-o5,mock-claude-fable-5,mock-claude-opus-5,mock-claude-sonnet-5,mock-claude-haiku-4.5,mock-gemini-3-pro,mock-gemini-3-flash,mock-deepseek-v4,mock-grok-5,mock-qwen3-max,mock-glm-5,mock-kimi-k3,mock-doubao-1.8-pro
