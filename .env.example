# Server
PORT=8787

# Latency model (global defaults; per-request override via body:
#   mock_ttft_ms / mock_interval_ms / mock_max_tokens / mock_fault)
TTFT_MS=500          # time to first token (stream) / initial delay (non-stream)
TOKEN_INTERVAL_MS=20 # per-token delay (~50 tok/s at 20ms)
DEFAULT_OUTPUT_TOKENS=512
MAX_OUTPUT_TOKENS=8192

# Fault injection (cumulative roll, 0 = off, 0.1 = 10% of requests)
# kinds: 429 | 500 | timeout | disconnect | pause | heartbeat | error_event (+ generic ERROR_RATE -> 500)
ERROR_RATE=0
ERROR_429_RATE=0
ERROR_500_RATE=0
ERROR_TIMEOUT_RATE=0   # hang for TIMEOUT_MS then 504
TIMEOUT_MS=30000
ERROR_DISCONNECT_RATE=0 # 200 + ~30% of stream, then socket destroyed (no end marker)
ERROR_PAUSE_RATE=0      # 200 + stream stalls PAUSE_MS mid-output, then resumes and completes
PAUSE_MS=20000
ERROR_HEARTBEAT_RATE=0  # 200 + SSE comments only (": ping"), no content, ends without end marker
HEARTBEAT_MS=30000
HEARTBEAT_INTERVAL_MS=1000
ERROR_EVENT_RATE=0      # 200 + protocol error event mid-stream, no end marker

# Models advertised at GET /v1/models
MODELS=mock-gpt-5.2,mock-gpt-5.2-mini,mock-o5,mock-claude-fable-5,mock-claude-opus-5,mock-claude-sonnet-5,mock-claude-haiku-4.5,mock-gemini-3-pro,mock-gemini-3-flash,mock-deepseek-v4,mock-grok-5,mock-qwen3-max,mock-glm-5,mock-kimi-k3,mock-doubao-1.8-pro
